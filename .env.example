###############################################################################
# TripToBD — Global Environment Configuration
###############################################################################
# This is the SINGLE source of truth for running the whole stack with
# docker-compose.yml. Copy it to `.env` and fill in the values:
#
#     cp .env.example .env
#
# docker-compose reads `.env` automatically and injects every value below into
# the correct service (the compose file handles the per-service variable-name
# mapping for you).
#
# You are expected to bring your OWN external infrastructure:
#   • PostgreSQL  (identity, hotel, vehicle, restaurant)
#   • MongoDB     (location; restaurant comments)
#   • RabbitMQ    (restaurant)
# These are NOT started by docker-compose — only the 5 Go services are.
###############################################################################


# ───────────────────────────── Shared / runtime ─────────────────────────────
# MODE must be exactly "debug" or "release".
MODE=debug

# Shared JWT signing secret used by every service. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Postgres SSL mode flag. MUST be a bare boolean: either true or false
# (no quotes) — restaurant builds it directly into JSON.
ENABLE_SSL_MODE=false

# Generic DB idle timeout (minutes), shared across services.
MAX_IDLE_TIME_IN_MINUTE=60


# ───────────────────────── External PostgreSQL ───────────────────────────────
# One server, one set of credentials; each service gets its own database below.
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASS=postgres

# Per-service database names (create these on your Postgres server).
IDENTITY_DB_NAME=identity_db
HOTEL_DB_NAME=hotel_db
VEHICLE_DB_NAME=vehicle_db
RESTAURANT_DB_NAME=restaurant_db


# ──────────────────────────── External MongoDB ──────────────────────────────
# Used by location-service (standard mongodb:// URI is built by compose).
MONGO_HOST=your-mongo-host
MONGO_PORT=27017
MONGO_USER=mongo
MONGO_PASS=mongo
MONGO_AUTH_SOURCE=admin
LOCATION_MONGO_DATABASE=location_db

# Restaurant stores its comments/posts in Mongo too.
# ⚠️ CAVEAT: restaurant-service/mongodb/connection.go connects using
#    `mongodb+srv://` (MongoDB Atlas SRV scheme). So MONGO_HOST for restaurant
#    must be an Atlas-style hostname (e.g. cluster0.xxxxx.mongodb.net).
#    If you run a standard standalone/replica-set Mongo, either point this at
#    an Atlas cluster or adjust that connection.go to use `mongodb://`.
RESTAURANT_MONGO_DB_NAME=restaurant_db


# ──────────────────────────── External RabbitMQ ─────────────────────────────
# AMQP connection URL for restaurant-service events.
RABBITMQ_URL=amqp://guest:guest@your-rabbit-host:5672/


# ───────────────────────── Host port mappings (gRPC + HTTP) ──────────────────
# These are the HOST ports published on your machine -> container.
IDENTITY_HTTP_PORT=5001

LOCATION_HTTP_PORT=6002
LOCATION_GRPC_PORT=3345

HOTEL_HTTP_PORT=5005
HOTEL_GRPC_PORT=3355

VEHICLE_HTTP_PORT=5006

RESTAURANT_HTTP_PORT=6001
# Restaurant gRPC is published on host port 3346 (3345 is taken by location).
# (internal container port is fixed at 3345 and is referenced as
#  location-service:3345 by other services on the compose network.)


# ─────────────────────── Identity service (REQUIRED) ─────────────────────────
# The identity service validates these on startup and will EXIT if any are
# empty, so non-empty placeholders are provided. Replace with real values when
# you wire up email + OAuth.
TOKEN_EXPIRE_TIME_IN_HOURS=72
ACCESS_TOKEN_TTL_IN_MINUTE=60
REFRESH_TOKEN_TTL_IN_MINUTE=1440
EMAIL_INVITATION_TTL_IN_MINUTE=10080
MAX_OPEN_CONNECTIONS=25
MAX_IDLE_CONNECTIONS=10

# SMTP / mail server (used for invitation emails).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=postmaster@example.com
MAIL_EMAIL=no-reply@example.com
MAIL_PASSWORD=changeme
FRONTEND_URL=http://localhost:3000/invitation?token=

# OAuth (goth) + session settings.
CLIENT_KEY=dev-oauth-client-key
SESSION_SECRET=dev-session-secret
CALL_BACK_URL=http://localhost:5001/auth/google/callback
