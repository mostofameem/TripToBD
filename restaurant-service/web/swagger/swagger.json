{
  "openapi": "3.0.0",
  "info": {
    "title": "Restaurant API",
    "version": "1.0.0"
  },
  "paths": {
    "/add-restaurant": {
      "post": {
        "summary": "Add a new restaurant",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "hotel3"
                  },
                  "content": {
                    "type": "string",
                    "example": "this is a nice test3"
                  },
                  "location": {
                    "type": "string",
                    "example": "test1 location"
                  },
                  "picture_url": {
                    "type": "string",
                    "example": "https://www.bdstall.com/asset/Rangpur/9225_giant.jpg"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Restaurant added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "example": "Location added Successfully"
                    },
                    "message": {
                      "type": "string",
                      "example": "Success"
                    },
                    "status": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get-restaurants": {
      "get": {
        "summary": "Get list of restaurants",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of restaurants",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 3
                          },
                          "title": {
                            "type": "string",
                            "example": "hotel test1"
                          },
                          "best_time": {
                            "type": "string",
                            "example": "https://www.bdstall.com/asset/Rangpur/9225_giant.jpg"
                          },
                          "picture_url": {
                            "type": "string",
                            "example": "test1 location"
                          },
                          "rating": {
                            "type": "integer",
                            "example": 0
                          },
                          "vote_count": {
                            "type": "integer",
                            "example": 0
                          },
                          "created_at": {
                            "type": "string",
                            "example": "2024-10-25T11:34:45.170623Z"
                          },
                          "updated_at": {
                            "type": "string",
                            "example": "2024-10-25T11:34:45.170624Z"
                          },
                          "is_active": {
                            "type": "boolean",
                            "example": false
                          }
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "example": "Success"
                    },
                    "status": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get-restaurants/location/{id}": {
      "get": {
        "summary": "Get restaurants by location ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Restaurants for a specific location",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 3
                          },
                          "title": {
                            "type": "string",
                            "example": "hotel test1"
                          },
                          "best_time": {
                            "type": "string",
                            "example": "https://www.bdstall.com/asset/Rangpur/9225_giant.jpg"
                          },
                          "picture_url": {
                            "type": "string",
                            "example": "test1 location"
                          },
                          "rating": {
                            "type": "integer",
                            "example": 0
                          },
                          "vote_count": {
                            "type": "integer",
                            "example": 0
                          },
                          "created_at": {
                            "type": "string",
                            "example": "2024-10-25T11:34:45.170623Z"
                          },
                          "updated_at": {
                            "type": "string",
                            "example": "2024-10-25T11:34:45.170624Z"
                          },
                          "is_active": {
                            "type": "boolean",
                            "example": false
                          }
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "example": "Success"
                    },
                    "status": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get-restaurant/{id}": {
      "get": {
        "summary": "Get restaurant by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 3
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Details of a specific restaurant",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "example": "3"
                        },
                        "title": {
                          "type": "string",
                          "example": "hotel test1"
                        },
                        "content": {
                          "type": "string",
                          "example": "this is a nice test1"
                        },
                        "best_time": {
                          "type": "string",
                          "example": ""
                        },
                        "picture_url": {
                          "type": "string",
                          "example": "https://www.bdstall.com/asset/Rangpur/9225_giant.jpg"
                        },
                        "rating": {
                          "type": "integer",
                          "example": 0
                        },
                        "author": {
                          "type": "object",
                          "properties": {
                            "userid": {
                              "type": "integer",
                              "example": 1
                            },
                            "username": {
                              "type": "string",
                              "example": "mostofa"
                            }
                          }
                        },
                        "branches": {
                          "type": "string",
                          "nullable": true
                        },
                        "comments": {
                          "type": "string",
                          "nullable": true
                        },
                        "created_at": {
                          "type": "string",
                          "example": "0001-01-01T00:00:00Z"
                        },
                        "updated_at": {
                          "type": "string",
                          "example": "0001-01-01T00:00:00Z"
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "example": "Success"
                    },
                    "status": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/restaurant/add-branch": {
      "post": {
        "summary": "Add branch to a restaurant",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "location_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "restaurant_id": {
                    "type": "integer",
                    "example": 3
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Branch added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "example": "Branch added successful"
                    },
                    "message": {
                      "type": "string",
                      "example": "Success"
                    },
                    "status": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/review-restaurant": {
      "post": {
        "summary": "Add a review for a restaurant",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "restaurant_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "comment": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "example": 5
                      },
                      "name": {
                        "type": "string",
                        "example": "hanif"
                      },
                      "content": {
                        "type": "string",
                        "example": "this is a nice place"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "example": "Review added successful"
                    },
                    "message": {
                      "type": "string",
                      "example": "Success"
                    },
                    "status": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Search Restaurants",
        "description": "Retrieve a list of restaurants matching the given title and location.",
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "description": "The title of the restaurant to search for (partial matching allowed).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "description": "The location of the restaurant to search for (partial matching allowed).",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of matching restaurants.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Restaurant"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
    "components": {
      "schemas": {
        "Restaurant": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "example": 1
            },
            "title": {
              "type": "string",
              "example": "Pizza Paradise"
            },
            "location_info": {
              "type": "string",
              "example": "New York"
            },
            "picture_url": {
              "type": "string",
              "example": "https://example.com/image.jpg"
            },
            "rating": {
              "type": "number",
              "format": "float",
              "example": 4.5
            },
            "vote_count": {
              "type": "integer",
              "example": 150
            },
            "created_at": {
              "type": "string",
              "format": "date-time",
              "example": "2024-01-01T12:00:00Z"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time",
              "example": "2024-01-05T15:30:00Z"
            },
            "is_active": {
              "type": "boolean",
              "example": true
            }
          }
        }
      }
    }
  }